<?xml version="1.0"?>
<!-- SolidWorks standing-pose geometry, laid out for CHAMP.

  Your export was already in the standing pose with all joint angles = 0.
  The bent-leg look is baked into the SolidWorks frame transforms (RPY), not
  into non-zero joint commands.

  CHAMP only sums joint XYZ and ignores RPY. So we re-express each joint origin
  as the *world-frame displacement* between consecutive link frames at that
  standing pose, with RPY = 0. Then:
    - q = 0 is still the SolidWorks standing pose (positions match)
    - CHAMP sees correct bone lengths (including the baked bend via X+Z components)
    - stand / spawn joint targets stay at 0

  Mesh visuals use the SolidWorks link orientation at standing so parts look right.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.141592653589793"/>
  <xacro:property name="damping" value="0.5"/>
  <xacro:property name="friction" value="0.1"/>
  <xacro:property name="hip_effort" value="12.0"/>
  <xacro:property name="thigh_effort" value="20.0"/>
  <xacro:property name="calf_effort" value="20.0"/>
  <xacro:property name="vel_limit" value="10.0"/>

  <!-- ===================== BASE / BODY ===================== -->
  <link name="base_link">
    <inertial>
      <origin xyz="0.02116 0 0.02494" rpy="0 0 0"/>
      <mass value="0.066"/>
      <inertia ixx="2.43e-05" ixy="0" ixz="0" iyy="8.07e-06" iyz="0" izz="2.69e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find quad_description)/meshes/base_link.STL"/>
      </geometry>
      <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
    </visual>
    <!-- No collision on base_link — body box handles chassis contact. -->
  </link>

  <link name="body">
    <inertial>
      <origin xyz="0.0685 0 0.0467" rpy="0 0 0"/>
      <mass value="0.497"/>
      <inertia ixx="0.00150" ixy="0" ixz="0" iyy="0.00145" iyz="0" izz="0.00267"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find quad_description)/meshes/body.STL"/>
      </geometry>
      <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
    </visual>
    <!-- Keep body collision above the hips so it does not hit the ground and flip the robot. -->
    <collision>
      <origin xyz="0.05 0 0.06" rpy="0 0 0"/>
      <geometry>
        <box size="0.25 0.14 0.06"/>
      </geometry>
    </collision>
  </link>

  <joint name="body_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="body"/>
  </joint>

  <link name="servos">
    <inertial>
      <origin xyz="0.076 0 0.0125" rpy="0 0 0"/>
      <mass value="0.127"/>
      <inertia ixx="2.17e-05" ixy="0" ixz="0" iyy="2.02e-05" iyz="0" izz="3.36e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find quad_description)/meshes/servos.STL"/>
      </geometry>
      <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
    </visual>
  </link>
  <joint name="servo_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="servos"/>
  </joint>

  <link name="lidar">
    <inertial>
      <origin xyz="0.031 0 0" rpy="0 0 0"/>
      <mass value="0.086"/>
      <inertia ixx="4.54e-05" ixy="0" ixz="0" iyy="2.33e-05" iyz="0" izz="3.78e-05"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="file://$(find quad_description)/meshes/lidar.STL"/>
      </geometry>
      <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <origin xyz="0.172825 0 0.087568" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="lidar"/>
  </joint>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.001"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <parent link="body"/>
    <child link="imu_link"/>
  </joint>

  <!-- ===================== LEG MACRO =====================
       Origins are world-frame deltas measured from the SolidWorks standing export
       (all joint angles = 0). mesh_rpy is the SW link orientation at that pose. -->
  <xacro:macro name="leg" params="prefix
                                   hip_xyz upper_xyz lower_xyz foot_xyz
                                   hip_mesh_rpy upper_mesh_rpy lower_mesh_rpy foot_mesh_rpy
                                   mesh_hip mesh_thigh mesh_calf mesh_foot">

    <joint name="${prefix}_hip_joint" type="revolute">
      <origin xyz="${hip_xyz}" rpy="0 0 0"/>
      <parent link="body"/>
      <child link="${prefix}_hip_link"/>
      <axis xyz="1 0 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <limit lower="-1.5708" upper="1.5708" effort="${hip_effort}" velocity="${vel_limit}"/>
    </joint>

    <link name="${prefix}_hip_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.118"/>
        <inertia ixx="3.36e-05" ixy="0" ixz="0" iyy="4.59e-05" iyz="0" izz="2.96e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${hip_mesh_rpy}"/>
        <geometry>
          <mesh filename="file://$(find quad_description)/meshes/${mesh_hip}"/>
        </geometry>
        <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <!-- Primitives only: full STL collisions often explode / flip the robot in Gazebo. -->
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.025"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_upper_leg_joint" type="revolute">
      <origin xyz="${upper_xyz}" rpy="0 0 0"/>
      <parent link="${prefix}_hip_link"/>
      <child link="${prefix}_upper_leg_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <limit lower="-2.0944" upper="2.0944" effort="${thigh_effort}" velocity="${vel_limit}"/>
    </joint>

    <link name="${prefix}_upper_leg_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.033"/>
        <inertia ixx="2.5e-06" ixy="0" ixz="0" iyy="7.0e-05" iyz="0" izz="7.0e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${upper_mesh_rpy}"/>
        <geometry>
          <mesh filename="file://$(find quad_description)/meshes/${mesh_thigh}"/>
        </geometry>
        <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.02"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_lower_leg_joint" type="revolute">
      <origin xyz="${lower_xyz}" rpy="0 0 0"/>
      <parent link="${prefix}_upper_leg_link"/>
      <child link="${prefix}_lower_leg_link"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="${damping}" friction="${friction}"/>
      <limit lower="-2.7925" upper="2.7925" effort="${calf_effort}" velocity="${vel_limit}"/>
    </joint>

    <link name="${prefix}_lower_leg_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.033"/>
        <inertia ixx="2.8e-06" ixy="0" ixz="0" iyy="4.5e-05" iyz="0" izz="4.5e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${lower_mesh_rpy}"/>
        <geometry>
          <mesh filename="file://$(find quad_description)/meshes/${mesh_calf}"/>
        </geometry>
        <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.018"/>
        </geometry>
      </collision>
    </link>

    <joint name="${prefix}_foot_joint" type="fixed">
      <origin xyz="${foot_xyz}" rpy="0 0 0"/>
      <parent link="${prefix}_lower_leg_link"/>
      <child link="${prefix}_foot_link"/>
    </joint>

    <link name="${prefix}_foot_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.039"/>
        <inertia ixx="1.5e-05" ixy="0" ixz="0" iyy="1.5e-05" iyz="0" izz="1.5e-05"/>
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="${foot_mesh_rpy}"/>
        <geometry>
          <mesh filename="file://$(find quad_description)/meshes/${mesh_foot}"/>
        </geometry>
        <material name="silver"><color rgba="0.79 0.82 0.93 1"/></material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.018"/>
        </geometry>
      </collision>
    </link>

  </xacro:macro>

  <!-- Measured world-frame deltas at SolidWorks standing (q=0).
       mesh_rpy = SW link orientation at that pose so meshes sit correctly. -->

  <!-- Left front -->
  <xacro:leg prefix="lf"
    hip_xyz="0.17415 0.1 0.0125"
    upper_xyz="-0.04915 0.03705 -0.0125"
    lower_xyz="-0.07324 0.0 -0.10741"
    foot_xyz="0.06224 0.0 -0.11902"
    hip_mesh_rpy="0 0 0"
    upper_mesh_rpy="0 0.972338 3.141593"
    lower_mesh_rpy="0 0.994094 0"
    foot_mesh_rpy="1.5708 0 0"
    mesh_hip="fll1.STL" mesh_thigh="fll2.STL" mesh_calf="fll3.STL" mesh_foot="flf.STL"/>

  <!-- Right front -->
  <xacro:leg prefix="rf"
    hip_xyz="0.17415 -0.1 0.0125"
    upper_xyz="-0.04915 -0.03705 -0.0125"
    lower_xyz="-0.07324 0.0 -0.10741"
    foot_xyz="0.06224 -0.01 -0.11902"
    hip_mesh_rpy="0 0 0"
    upper_mesh_rpy="0 0.972338 3.141593"
    lower_mesh_rpy="0 0.994094 0"
    foot_mesh_rpy="1.5708 0 0"
    mesh_hip="frl1.STL" mesh_thigh="frl2.STL" mesh_calf="frl3.STL" mesh_foot="frf.STL"/>

  <!-- Left hind -->
  <xacro:leg prefix="lh"
    hip_xyz="-0.07585 0.1 0.0125"
    upper_xyz="-0.04915 0.03705 -0.0125"
    lower_xyz="-0.07324 0.0 -0.10741"
    foot_xyz="0.07324 0.0 -0.11260"
    hip_mesh_rpy="0 0 0"
    upper_mesh_rpy="0 0.972338 3.141593"
    lower_mesh_rpy="0 0.994094 0"
    foot_mesh_rpy="1.5708 0 0"
    mesh_hip="rll1.STL" mesh_thigh="rll2.STL" mesh_calf="rll3.STL" mesh_foot="rlf.STL"/>

  <!-- Right hind -->
  <xacro:leg prefix="rh"
    hip_xyz="-0.07585 -0.1 0.0125"
    upper_xyz="-0.04915 -0.03705 -0.0125"
    lower_xyz="-0.07324 0.0 -0.10741"
    foot_xyz="0.07324 -0.01 -0.11260"
    hip_mesh_rpy="0 0 0"
    upper_mesh_rpy="0 0.972338 3.141593"
    lower_mesh_rpy="0 0.994094 0"
    foot_mesh_rpy="1.5708 0 0"
    mesh_hip="rrl1.STL" mesh_thigh="rrl2.STL" mesh_calf="rrl3.STL" mesh_foot="rrf.STL"/>

</robot>
